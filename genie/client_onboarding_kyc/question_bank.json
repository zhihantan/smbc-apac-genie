    {
      "kind": "starter",
      "id": "S2",
      "question": "Which stage adds the most days for Financial Institution clients, and did it change after February 2026?",
      "after": null,
      "benchmark": "Q2",
      "matched": "Q2",
      "verdict": "match",
      "note": "same rows as the benchmark",
      "status": "COMPLETED",
      "genie_sql": "WITH st AS (\n  SELECT `Stage Number`, `Stage`, `Is After KYC Migration`, MEASURE(`Average Days in Stage`) AS avg_days_in_stage\n  FROM smbc_genie.metrics.mv_onboarding_cycle_time\n  WHERE `Request Segment` = :request_segment AND `Stage Number` <= 6\n  GROUP BY ALL\n)\nSELECT `Stage Number`, `Stage`,\n       max(CASE WHEN NOT `Is After KYC Migration` THEN avg_days_in_stage END) AS avg_days_before_feb_2026,\n       max(CASE WHEN `Is After KYC Migration` THEN avg_days_in_stage END)     AS avg_days_from_feb_2026\nFROM st\nGROUP BY `Stage Number`, `Stage`\nORDER BY `Stage Number`",
      "genie_parameters": [
        {
          "keyword": "request_segment",
          "value": "Financial Institution",
          "sql_type": "STRING"
        }
      ],
      "genie_columns": [
        "Stage Number",
        "Stage",
        "avg_days_before_feb_2026",
        "avg_days_from_feb_2026"
      ],
      "genie_rows": 6,
      "seconds": 18.0,
      "asked_at": "2026-10-04T14:40:14+00:00",
      "conversation_deleted": true
    },
