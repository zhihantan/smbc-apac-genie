    {
      "kind": "starter",
      "id": "S4",
      "question": "How many golden clients are missing KYC or credit data, by relationship tier?",
      "after": null,
      "benchmark": "Q4",
      "matched": "Q4",
      "verdict": "match",
      "note": "same rows as the benchmark",
      "status": "COMPLETED",
      "genie_sql": "SELECT `Relationship Tier`,\n       MEASURE(`Golden Clients`)              AS golden_clients,\n       MEASURE(`Clients Missing KYC Data`)    AS missing_kyc,\n       MEASURE(`Clients Missing Credit Data`) AS missing_credit\nFROM smbc_genie.metrics.mv_golden_record_coverage\nWHERE `Month` = :month\nGROUP BY ALL\nORDER BY `Relationship Tier`",
      "genie_parameters": [
        {
