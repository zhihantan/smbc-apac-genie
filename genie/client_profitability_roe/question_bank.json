  "questions": [
    {
      "kind": "starter",
      "id": "S1",
      "question": "Top and bottom 20 client groups by ROE in FY2025, with revenue, capital and credit cost.",
      "after": null,
      "benchmark": "Q1",
      "matched": "Q1",
      "verdict": "match",
      "note": "same rows as the benchmark",
      "status": "COMPLETED",
      "genie_sql": "WITH g AS (\n  SELECT `Client Group`,\n         MEASURE(`ROE %`)                 AS roe,\n         MEASURE(`Median Client ROE %`)   AS median_client_roe,\n         MEASURE(`Revenue USD`)           AS revenue_usd,\n         MEASURE(`Allocated Capital USD`) AS allocated_capital_usd,\n         MEASURE(`Credit Cost USD`)       AS credit_cost_usd\n  FROM smbc_genie.metrics.mv_roe_waterfall\n  WHERE `Fiscal Year` = :fiscal_year AND `Client Group` IS NOT NULL\n  GROUP BY ALL\n  HAVING MEASURE(`Allocated Capital USD`) > CAST(:min_capital_usd AS DOUBLE)\n), r AS (\n  SELECT g.*, rank() OVER (ORDER BY roe DESC) AS top_rank, rank() OVER (ORDER BY roe ASC) AS bottom_rank FROM g\n)\nSELECT CASE WHEN top_rank <= 20 THEN 'Top 20' ELSE 'Bottom 20' END AS list, `Client Group` AS client_group, roe,\n       median_client_roe, revenue_usd, allocated_capital_usd, credit_cost_usd\nFROM r\nWHERE top_rank <= 20 OR bottom_rank <= 20\nORDER BY roe DESC",
      "genie_parameters": [
        {
          "keyword": "fiscal_year",
          "value": "FY2025",
          "sql_type": "STRING"
        },
